{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MuseDraw scene",
  "description": "Scene structure for the MuseDraw scene engine. Extra fields remain allowed for compatibility. Cross-object references and layout relationships are checked by the engine.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "footer": {
      "anyOf": [
        {
          "const": false
        },
        {
          "type": "string"
        }
      ]
    },
    "theme": {
      "type": "string"
    },
    "style": {
      "type": "object",
      "description": "Scene-local visual tokens merged over the named theme; does not change the theme identity.",
      "additionalProperties": false,
      "properties": {
        "palette": { "type": "object" },
        "fonts": { "type": "object" },
        "canvas": { "type": "object" },
        "node": { "type": "object" },
        "tones": { "type": "object" },
        "zone": { "type": "object" },
        "edge": { "type": "object" },
        "step": { "type": "object" },
        "note": { "type": "object" },
        "legend": { "type": "object" }
      }
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "kicker": {
      "type": "string"
    },
    "figure": {
      "type": "string"
    },
    "seal": {
      "type": "string"
    },
    "shortTitle": {
      "type": "string"
    },
    "type": {
      "enum": [
        "graph",
        "sequence",
        "vector"
      ]
    },
    "nativeSvg": {
      "type": "string",
      "description": "Static native vector artwork for exact replay; no graph-theme switching."
    },
    "size": {
      "type": "array",
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "minItems": 2,
      "maxItems": 2
