{
  "id": "whiteboard",
  "name": "Whiteboard",
  "nameZh": "白板手绘",
  "aliases": [
    "手绘",
    "白板",
    "sketch",
    "hand-drawn"
  ],
  "summary": "Marker on whiteboard: rough strokes, hachure fills, sticky notes and curved arrows. For early-stage design conversations where nothing is final.",
  "palette": {
    "bg": "#FBFBF8",
    "ink": "#1E1E1E",
    "muted": "#5C5F66",
    "accent": "#E03131",
    "blue": "#1971C2",
    "green": "#2F9E44",
    "orange": "#E8590C",
    "violet": "#7048E8"
  },
  "fonts": {
    "display": "Caveat, LXGW WenKai, cursive",
    "body": "Caveat, LXGW WenKai, cursive",
    "mono": "Caveat, LXGW WenKai, cursive",
    "hand": "Caveat, LXGW WenKai, cursive"
  },
  "canvas": {
    "bg": "bg",
    "margin": 64,
    "texture": "dots",
    "textureGap": 28,
    "textureColor": "#C9CBD1",
    "textureOpacity": 0.7
