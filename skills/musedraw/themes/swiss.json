    "font": "mono",
    "size": 11,
    "color": "ink",
    "titleColor": "ink"
  },
  "footer": {
    "text": "MuseDraw / Swiss Poster",
    "font": "mono",
    "size": 11,
    "color": "ink",
    "letterSpacing": 0
  }
