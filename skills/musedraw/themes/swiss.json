  "nameZh": "瑞士海报",
  "aliases": [
    "瑞士",
    "swiss",
    "international"
  ],
  "summary": "Grotesk type at poster scale, a strict column grid, black and one signal red. For step-by-step flows people should remember.",
  "palette": {
    "bg": "#F2F1EC",
    "card": "#FFFFFF",
    "ink": "#0B0B0B",
    "muted": "#5E5E5A",
    "accent": "#E3001B",
    "rule": "#0B0B0B",
    "light": "#DCDAD2"
  },
  "fonts": {
    "display": "Archivo, Noto Sans SC, sans-serif",
    "body": "Archivo, Noto Sans SC, sans-serif",
    "mono": "Space Mono, Noto Sans SC, monospace"
  },
  "canvas": {
    "bg": "bg",
    "margin": 64
  },
  "header": {
    "layout": "poster",
    "titleFont": "display",
    "titleSize": 80,
    "titleWeight": 800,
    "titleLetterSpacing": -2.5,
