      "fill": "none",
      "stroke": "ink",
      "strokeWidth": 1.5,
      "text": "ink",
      "sub": "muted",
      "tag": "muted",
      "topBar": null
    },
    "chipR": {
      "fill": "accent",
      "stroke": "none",
      "text": "#FFFFFF",
      "topBar": null
    },
    "chipA": {
      "fill": "ink",
      "stroke": "none",
      "text": "#FFFFFF",
      "topBar": null
    },
    "chipC": {
      "fill": "none",
      "stroke": "ink",
      "strokeWidth": 1.5,
      "text": "ink",
      "topBar": null
    },
    "chipI": {
      "fill": "light",
      "stroke": "none",
      "text": "ink",
      "topBar": null
    }
