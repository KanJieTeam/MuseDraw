  "externals": [
    {"id":"visitor","label":"访问者","kind":"person","technology":null,"detail":"点击短链接","placement":"before","ownership":null},
    {"id":"web","label":"Web 前端","kind":"container","containerType":"application","technology":"Vue","detail":"用户粘贴长链接","placement":"before","ownership":null},
    {"id":"redis","label":"Redis","kind":"container","containerType":"data","technology":"缓存","detail":"短码 → 长链接","placement":"after","ownership":null},
    {"id":"mysql","label":"MySQL","kind":"container","containerType":"data","technology":"数据库","detail":"全部映射记录","placement":"after","ownership":null},
    {"id":"kafka","label":"消息队列","kind":"container","containerType":"queue","technology":"Kafka","detail":"点击事件","placement":"after","ownership":null},
    {"id":"statistics","label":"统计服务","kind":"container","containerType":"application","technology":"Python","detail":"按天汇总点击量","placement":"after","ownership":"其他团队"}
  ],
  "relationships": [
    {"id":"visit","from":"visitor","to":"redirect","label":"打开 /4c92","technology":"HTTPS"},
    {"id":"submit","from":"web","to":"create","label":"提交长链接","technology":"JSON/HTTPS"},
    {"id":"code","from":"create","to":"generator","label":"申请短码","technology":null},
    {"id":"save","from":"create","to":"repository","label":"保存映射","technology":null},
    {"id":"query","from":"redirect","to":"repository","label":"按短码查询","technology":null},
    {"id":"cache-first","from":"repository","to":"cache","label":"先查缓存","technology":null},
    {"id":"redis-io","from":"cache","to":"redis","label":"读写","technology":"RESP"},
    {"id":"fallback","from":"repository","to":"mysql","label":"缓存未命中时","technology":"SQL"},
    {"id":"click","from":"redirect","to":"publisher","label":null,"technology":null},
    {"id":"publish","from":"publisher","to":"kafka","label":"发布事件","technology":null},
    {"id":"subscribe","from":"kafka","to":"statistics","label":"订阅点击事件","technology":null}
