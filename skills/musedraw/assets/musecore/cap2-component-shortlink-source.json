    {"id":"generator","label":"短码生成器","technology":null,"detail":"发号器 + Base62 编码"},
    {"id":"repository","label":"链接仓库","technology":null,"detail":"读写短码与长链接映射"},
    {"id":"cache","label":"缓存客户端","technology":null,"detail":"热门短码放进缓存"},
    {"id":"publisher","label":"点击事件发布器","technology":null,"detail":"异步记录每次访问"}
