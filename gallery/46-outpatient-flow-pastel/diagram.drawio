olor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=16.61;fontStyle=1;fontColor=#d9730d;opacity=100;rotation=0;"><mxGeometry x="0" y="-5.41" width="33.61" height="24" as="geometry"></mxGeometry></mxCell><mxCell id="text-64" value="排队最久的两个环节。下一步：候诊改为“到号前 15 分钟提醒”，检查按时段预约。" vertex="1" parent="group-62" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=15.1;fontStyle=0;fontColor=#37352f;opacity=100;rotation=0;"><mxGeometry x="46.55" y="-4.41" width="567.141" height="22" as="geometry"></mxGeometry></mxCell><mxCell id="text-68" value="门诊服务 · 患者视角" vertex="1" parent="group-67" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=14;fontStyle=0;fontColor=#787774;opacity=100;rotation=0;"><mxGeometry x="0" y="0" width="137.781" height="20" as="geometry"></mxGeometry></mxCell><mxCell id="text-69" value="门诊就诊流程优化" vertex="1" parent="group-67" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=42;fontStyle=1;fontColor=#37352f;opacity=100;rotation=0;"><mxGeometry x="0" y="21.12" width="336" height="61" as="geometry"></mxGeometry></mxCell><mxCell id="text-70" value="线下 9 步里有 4 步在排队。把挂号、缴费、报告搬到手机上之后，患者在院时间从 2.5 小时降到 70 分钟。" vertex="1" parent="group-67" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=17.3;fontStyle=0;fontColor=#787774;opacity=100;rotation=0;"><mxGeometry x="0" y="87.3" width="802.266" height="25" as="geometry"></mxGeometry></mxCell><mxCell id="text-72" value="MuseDraw · 柔和笔记" vertex="1" parent="group-71" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=12;fontStyle=0;fontColor=#b4b4b0;opacity=100;rotation=0;"><mxGeometry x="0" y="0" width="138.625" height="17" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
