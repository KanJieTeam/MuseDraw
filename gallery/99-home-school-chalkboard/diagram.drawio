eft;verticalAlign=top;spacing=0;fontFamily=LXGW WenKai;fontSize=24;fontStyle=1;fontColor=#9dd3f2;opacity=100;rotation=0;"><mxGeometry x="86" y="27.88" width="168" height="32" as="geometry"></mxGeometry></mxCell><mxCell id="text-13" value="本周主题、照片、下周需要家长准备&#xa;的材料" vertex="1" parent="group-9" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=LXGW WenKai;fontSize=18.9;fontStyle=0;fontColor=#f3f1e7;opacity=100;rotation=0;"><mxGeometry x="18.797" y="55.7" width="302.5" height="49.95" as="geometry"></mxGeometry></mxCell><mxCell id="text-16" value="每月" vertex="1" parent="group-14" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=LXGW WenKai;fontSize=16.2;fontStyle=0;fontColor=#b9c4b5;opacity=100;rotation=0;"><mxGeometry x="153.797" y="10.28" width="32.406" height="22" as="geometry"></mxGeometry></mxCell><mxCell id="text-17" value="一对一成长记录" vertex="1" parent="group-14" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=LXGW WenKai;fontSize=24;fontStyle=1;fontColor=#b5e3a1;opacity=100;rotation=0;"><mxGeometry x="86" y="27.88" width="168" height="32" as="geometry"></mxGeometry></mxCell><mxCell id="text-18" value="观察记录 + 作品，家长写回执" vertex="1" parent="group-14" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=LXGW WenKai;fontSize=18.9;fontStyle=0;fontColor=#f3f1e7;opacity=100;rotation=0;"><mxGeometry x="44.313" y="55.7" width="252.47" height="25" as="geometry"></mxGeometry></mxCell><mxCell id="text-21" value="每学期" vertex="1" parent="group-19" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=LXGW WenKai;fontSize=16.2;fontStyle=0;fontColor=#b9c4b5;opacity=100;rotation=0;"><mxGeometry x="145.695" y="10.28" width="48.609" height="22" as="geometry"></mxGeometry></mxCell><mxCell id="text-22" value="家长会与开放日" vertex="1" parent="group-19" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=LXGW WenKai;fontSize=24;fontStyle=1;fontColor=#f6b97a;opacity=100;rotation=0;"><mxGeometry x="86" y="27.88" width="168" height="32" as="geometry"></mxGeometry></mxCell><mxCell id="text-23" value="看孩子在园的一天，交流下一阶段目&#xa;标" vertex="1" parent="group-19" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=LXGW WenKai;fontSize=18.9;fontStyle=0;fontColor=#f3f1e7;opacity=100;rotation=0;"><mxGeometry x="18.797" y="55.7" width="302.406" height="49.95" as="geometry"></mxGeometry></mxCell><mxCell id="text-26" value="出现问题时" vertex="1" parent="group-24" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=LXGW WenKai;fontSize=22;fontStyle=1;fontColor=#f4a6be;opacity=100;rotation=0;"><mxGeometry x="205" y="28.09" width="110" height="29" as="geometry"></mxGeometry></mxCell><mxCell id="text-27" value="当天电话，不在群里讨论个别孩子" vertex="1" parent="group-24" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=LXGW WenKai;fontSize=18.9;fontStyle=0;fontColor=#f3f1e7;opacity=100;rotation=0;"><mxGeometry x="118.25" y="53.55" width="283.6" height="25" as="geometry"></mxGeometry></mxCell><mxCell id="text-30" value="面谈约定" vertex="1" parent="group-28" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=LXGW WenKai;fontSize=22;fontStyle=1;fontColor=#f4a6be;opacity=100;rotation=0;"><mxGeometry x="216" y="28.09" width="88" height="29" as="geometry"></mxGeometry></mxCell><mxCell id="text-31" value="三天内约时间，老师、家长、保育员三方" vertex="1" parent="group-28" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=LXGW WenKai;fontSize=18.9;fontStyle=0;fontColor=#f3f1e7;opacity=100;rotation=0;"><mxGeometry x="89.898" y="53.55" width="340.3" height="25" as="geometry"></mxGeometry></mxCell><mxCell id="text-35" value="★ 群里只发集体信息；涉及某一个孩子的话，一律私下说。" vertex="1" parent="group-34" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=LXGW WenKai;fontSize=19;fontStyle=0;fontColor=#f7e36b;opacity=100;rotation=0;"><mxGeometry x="0" y="0" width="501.656" height="25" as="geometry"></mxGeometry></mxCell><mxCell id="text-37" value="幼儿园大班 · 家园共育" vertex="1" parent="group-36" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=LXGW WenKai;fontSize=18;fontStyle=0;fontColor=#f6dd72;opacity=100;rotation=0;"><mxGeometry x="0" y="0" width="192.906" height="24" as="geometry"></mxGeometry></mxCell><mxCell id="text-38" value="家园沟通四个频率" vertex="1" parent="group-36" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=LXGW WenKai;fontSize=50;fontStyle=1;fontColor=#f3f1e7;opacity=100;rotation=0;"><mxGeometry x="0" y="22" width="400" height="66" as="geometry"></mxGeometry></mxCell><mxCell id="text-39" value="日常沟通按固定节奏走，家长知道什么时候能得到什么信息；特殊情况单独处理，不占用日常渠道。" vertex="1" parent="group-36" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=LXGW WenKai;fontSize=20.5;fontStyle=0;fontColor=#b9c4b5;opacity=100;rotation=0;"><mxGeometry x="0" y="94.5" width="902" height="27" as="geometry"></mxGeometry></mxCell><mxCell id="text-41" value="MuseDraw · 黑板教学" vertex="1" parent="group-40" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=LXGW WenKai;fontSize=15;fontStyle=0;fontColor=#7f9384;opacity=100;rotation=0;"><mxGeometry x="0" y="0" width="165.172" height="19" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
