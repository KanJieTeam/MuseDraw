ne;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=13;fontStyle=0;fontColor=#3f6b49;opacity=100;rotation=0;"><mxGeometry x="54.156" y="48.16" width="91.688" height="16" as="geometry"></mxGeometry></mxCell><mxCell id="text-43" value="农村" vertex="1" parent="group-41" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=15;fontStyle=1;fontColor=#1e4a28;opacity=100;rotation=0;"><mxGeometry x="84" y="29.8" width="31" height="19" as="geometry"></mxGeometry></mxCell><mxCell id="text-44" value="18 村 × 20 户" vertex="1" parent="group-41" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=13;fontStyle=0;fontColor=#3f6b49;opacity=100;rotation=0;"><mxGeometry x="60.656" y="48.16" width="78.688" height="16" as="geometry"></mxGeometry></mxCell><mxCell id="text-48" value="第二阶段：城乡二次分层  ·  第三阶段：PPS 抽取社区 / 村（规模越大，入样概率越高）  ·  第四阶段：每户 Kish 表随机抽一人" vertex="1" parent="group-47" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=14;fontStyle=0;fontColor=#5f6368;opacity=100;rotation=0;"><mxGeometry x="0" y="0" width="762.109" height="17" as="geometry"></mxGeometry></mxCell><mxCell id="text-49" value="分析时需使用抽样权重并按整群计算标准误，否则置信区间会被低估。" vertex="1" parent="group-47" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=14;fontStyle=1;fontColor=#c2423f;opacity=100;rotation=0;"><mxGeometry x="0" y="34" width="434" height="17" as="geometry"></mxGeometry></mxCell><mxCell id="text-51" value="图 4 | 多阶段分层整群抽样设计" vertex="1" parent="group-50" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=22;fontStyle=1;fontColor=#1b1b1b;opacity=100;rotation=0;"><mxGeometry x="0" y="0" width="302.688" height="28" as="geometry"></mxGeometry></mxCell><mxCell id="text-52" value="示例：全国老年人数字生活调查。先分层保证代表性，再整群降低成本，最后户内随机抽取一位 60 岁以上成员。括号内为样本量。" vertex="1" parent="group-50" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=15.1;fontStyle=0;fontColor=#5f6368;opacity=100;rotation=0;"><mxGeometry x="0" y="39.18" width="872.984" height="19" as="geometry"></mxGeometry></mxCell><mxCell id="text-54" value="MuseDraw · Journal Figure" vertex="1" parent="group-53" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=10.5;fontStyle=0;fontColor=#a0a4aa;opacity=100;rotation=0;"><mxGeometry x="0" y="0" width="146.313" height="13" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
