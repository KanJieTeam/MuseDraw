lign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=13.5;fontStyle=0;fontColor=#787774;opacity=100;rotation=0;"><mxGeometry x="7" y="0" width="41" height="20" as="geometry"></mxGeometry></mxCell><mxCell id="text-80" value="合并压缩" vertex="1" parent="group-78" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=13.5;fontStyle=0;fontColor=#787774;opacity=100;rotation=0;"><mxGeometry x="7" y="0" width="54.5" height="20" as="geometry"></mxGeometry></mxCell><mxCell id="text-83" value="1" vertex="1" parent="group-82" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=16.61;fontStyle=1;fontColor=#d9730d;opacity=100;rotation=0;"><mxGeometry x="0" y="-5.41" width="10" height="24" as="geometry"></mxGeometry></mxCell><mxCell id="text-84" value="本地先改。界面不等服务器，零延&#xa;迟。" vertex="1" parent="group-82" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=15.1;fontStyle=0;fontColor=#37352f;opacity=100;rotation=0;"><mxGeometry x="26" y="-4.41" width="226.5" height="46.16" as="geometry"></mxGeometry></mxCell><mxCell id="text-86" value="2" vertex="1" parent="group-85" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=16.61;fontStyle=1;fontColor=#d9730d;opacity=100;rotation=0;"><mxGeometry x="0" y="-5.41" width="10" height="24" as="geometry"></mxGeometry></mxCell><mxCell id="text-87" value="只发送增量，通常几十个字节，而&#xa;不是整篇文档。" vertex="1" parent="group-85" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=15.1;fontStyle=0;fontColor=#37352f;opacity=100;rotation=0;"><mxGeometry x="26" y="-4.41" width="226.5" height="46.16" as="geometry"></mxGeometry></mxCell><mxCell id="text-89" value="3" vertex="1" parent="group-88" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=16.61;fontStyle=1;fontColor=#d9730d;opacity=100;rotation=0;"><mxGeometry x="0" y="-5.41" width="10" height="24" as="geometry"></mxGeometry></mxCell><mxCell id="text-90" value="服务端不做冲突判断，只把增量转&#xa;发给同房间的人。" vertex="1" parent="group-88" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=15.1;fontStyle=0;fontColor=#37352f;opacity=100;rotation=0;"><mxGeometry x="26" y="-4.41" width="226.5" height="46.16" as="geometry"></mxGeometry></mxCell><mxCell id="text-92" value="4" vertex="1" parent="group-91" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=16.61;fontStyle=1;fontColor=#d9730d;opacity=100;rotation=0;"><mxGeometry x="0" y="-5.41" width="10" height="24" as="geometry"></mxGeometry></mxCell><mxCell id="text-93" value="各端用 CRDT 合并，先到后到结果&#xa;都一样。" vertex="1" parent="group-91" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=15.1;fontStyle=0;fontColor=#37352f;opacity=100;rotation=0;"><mxGeometry x="26" y="-4.41" width="226.188" height="46.16" as="geometry"></mxGeometry></mxCell><mxCell id="text-95" value="5" vertex="1" parent="group-94" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=16.61;fontStyle=1;fontColor=#d9730d;opacity=100;rotation=0;"><mxGeometry x="0" y="-5.41" width="10" height="24" as="geometry"></mxGeometry></mxCell><mxCell id="text-96" value="定期把日志压成快照，新加入的人&#xa;秒开。" vertex="1" parent="group-94" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=15.1;fontStyle=0;fontColor=#37352f;opacity=100;rotation=0;"><mxGeometry x="26" y="-4.41" width="226.5" height="46.16" as="geometry"></mxGeometry></mxCell><mxCell id="text-100" value="CRDT · 以 Yjs 为例" vertex="1" parent="group-99" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=14;fontStyle=0;fontColor=#787774;opacity=100;rotation=0;"><mxGeometry x="0" y="0" width="129.328" height="20" as="geometry"></mxGeometry></mxCell><mxCell id="text-101" value="实时协同编辑（CRDT）架构" vertex="1" parent="group-99" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=42;fontStyle=1;fontColor=#37352f;opacity=100;rotation=0;"><mxGeometry x="0" y="21.12" width="530.938" height="61" as="geometry"></mxGeometry></mxCell><mxCell id="text-102" value="两个人同时改同一段文字，为什么不会互相覆盖？每个客户端都有完整副本，只交换“增量”，而合并结果与到达顺序无关。" vertex="1" parent="group-99" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=17.3;fontStyle=0;fontColor=#787774;opacity=100;rotation=0;"><mxGeometry x="0" y="87.3" width="950.953" height="25" as="geometry"></mxGeometry></mxCell><mxCell id="text-104" value="MuseDraw · 柔和笔记" vertex="1" parent="group-103" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=12;fontStyle=0;fontColor=#b4b4b0;opacity=100;rotation=0;"><mxGeometry x="0" y="0" width="138.625" height="17" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
