hen leaves. Success = not being needed." vertex="1" parent="group-44" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Archivo;fontSize=16.2;fontStyle=0;fontColor=#151515;opacity=100;rotation=0;"><mxGeometry x="26" y="0.58" width="558.625" height="17" as="geometry"></mxGeometry></mxCell><mxCell id="text-48" value="◆" vertex="1" parent="group-47" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Archivo;fontSize=17.82;fontStyle=1;fontColor=#d7263d;opacity=100;rotation=0;"><mxGeometry x="-1" y="-1.42" width="19" height="20" as="geometry"></mxGeometry></mxCell><mxCell id="text-49" value="Complicated subsystem: deep specialists behind a clean interface." vertex="1" parent="group-47" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Archivo;fontSize=16.2;fontStyle=0;fontColor=#151515;opacity=100;rotation=0;"><mxGeometry x="26" y="0.58" width="474.609" height="17" as="geometry"></mxGeometry></mxCell><mxCell id="text-51" value="▬" vertex="1" parent="group-50" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Archivo;fontSize=17.82;fontStyle=1;fontColor=#d7263d;opacity=100;rotation=0;"><mxGeometry x="0" y="-1.42" width="18" height="20" as="geometry"></mxGeometry></mxCell><mxCell id="text-52" value="Platform: a product for internal teams, consumed self-service." vertex="1" parent="group-50" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Archivo;fontSize=16.2;fontStyle=0;fontColor=#151515;opacity=100;rotation=0;"><mxGeometry x="26" y="0.58" width="437.688" height="17" as="geometry"></mxGeometry></mxCell><mxCell id="text-56" value="ORG DESIGN · TEAM TOPOLOGIES" vertex="1" parent="group-55" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Space Mono;fontSize=13;fontStyle=1;fontColor=#d7263d;opacity=100;rotation=0;"><mxGeometry x="0" y="0" width="250.781" height="20" as="geometry"></mxGeometry></mxCell><mxCell id="text-57" value="TEAM TOPOLOGIES: FOUR TEAM TYPES" vertex="1" parent="group-55" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Archivo;fontSize=68;fontStyle=1;fontColor=#151515;opacity=100;rotation=0;"><mxGeometry x="0" y="31.48" width="1422.797" height="74" as="geometry"></mxGeometry></mxCell><mxCell id="text-58" value="Stream-aligned teams ship to customers. Everyone else exists to make them faster —&#xa;and says how: collaborate, facilitate, or offer X-as-a-service." vertex="1" parent="group-55" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Archivo;fontSize=19.4;fontStyle=0;fontColor=#151515;opacity=100;rotation=0;"><mxGeometry x="0" y="117.4" width="728.391" height="49.13" as="geometry"></mxGeometry></mxCell><mxCell id="text-59" value="NO. 50" vertex="1" parent="group-55" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Space Mono;fontSize=13;fontStyle=0;fontColor=#151515;opacity=100;rotation=0;"><mxGeometry x="1458.25" y="0" width="53.75" height="20" as="geometry"></mxGeometry></mxCell><mxCell id="text-61" value="MUSEDRAW / BAUHAUS" vertex="1" parent="group-60" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Space Mono;fontSize=11;fontStyle=0;fontColor=#151515;opacity=100;rotation=0;"><mxGeometry x="0" y="0" width="139.188" height="16" as="geometry"></mxGeometry></mxC