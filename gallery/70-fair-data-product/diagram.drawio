gn=top;spacing=0;fontFamily=Inter;fontSize=13.5;fontStyle=0;fontColor=#c7d2fe;opacity=100;rotation=0;"><mxGeometry x="46" y="61.15" width="81.058" height="33.82" as="geometry"></mxGeometry></mxCell><mxCell id="text-83" value="Folder rule" vertex="1" parent="group-81" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=14;fontStyle=1;fontColor=#101828;opacity=100;rotation=0;"><mxGeometry x="12" y="12" width="73.586" height="17" as="geometry"></mxGeometry></mxCell><mxCell id="text-84" value="data/raw · data/derived · code · results · docs — and a README at the top that someone else could follow&#xa;without asking you." vertex="1" parent="group-81" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=14;fontStyle=0;fontColor=#667085;opacity=100;rotation=0;"><mxGeometry x="12" y="31.6" width="696.94" height="38" as="geometry"></mxGeometry></mxCell><mxCell id="text-87" value="Before you submit" vertex="1" parent="group-85" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=14;fontStyle=1;fontColor=#101828;opacity=100;rotation=0;"><mxGeometry x="12" y="12" width="125.219" height="17" as="geometry"></mxGeometry></mxCell><mxCell id="text-88" value="Delete your local derived/ folder and regenerate it from raw/ with one command. If that fails, the paper is not&#xa;reproducible yet." vertex="1" parent="group-85" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=14;fontStyle=0;fontColor=#667085;opacity=100;rotation=0;"><mxGeometry x="12" y="31.6" width="716.225" height="38" as="geometry"></mxGeometry></mxCell><mxCell id="text-92" value="Research data management" vertex="1" parent="group-91" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=13;fontStyle=1;fontColor=#4f46e5;opacity=100;rotation=0;"><mxGeometry x="0" y="0" width="180.428" height="16" as="geometry"></mxGeometry></mxCell><mxCell id="text-93" value="FAIR research data workflow" vertex="1" parent="group-91" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=44;fontStyle=1;fontColor=#101828;opacity=100;rotation=0;"><mxGeometry x="0" y="25.84" width="581.882" height="54" as="geometry"></mxGeometry></mxCell><mxCell id="text-94" value="Raw data is read-only from the moment it leaves the instrument. Everything after it is produced by versioned code, so any figure&#xa;can be regenerated from scratch." vertex="1" parent="group-91" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=18.4;fontStyle=0;fontColor=#667085;opacity=100;rotation=0;"><mxGeometry x="0" y="89.4" width="1113.544" height="48.68" as="geometry"></mxGeometry></mxCell><mxCell id="text-96" value="MuseDraw · Product Clean" vertex="1" parent="group-95" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=11;fontStyle=0;fontColor=#98a2b3;opacity=100;rotation=0;"><mxGeometry x="0" y="0" width="146.172" height="14" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
