gn=top;spacing=0;fontFamily=Space Grotesk;fontSize=16.2;fontStyle=0;fontColor=#2648b8;opacity=100;rotation=0;"><mxGeometry x="26" y="-1.42" width="200.641" height="65.72" as="geometry"></mxGeometry></mxCell><mxCell id="text-116" value="3" vertex="1" parent="group-115" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Space Grotesk;fontSize=17.82;fontStyle=1;fontColor=#ff4f93;opacity=100;rotation=0;"><mxGeometry x="0" y="-3.42" width="11" height="23" as="geometry"></mxGeometry></mxCell><mxCell id="text-117" value="Offsets belong to the&#xa;consumer. The lake can&#xa;replay last week without&#xa;touching a producer." vertex="1" parent="group-115" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Space Grotesk;fontSize=16.2;fontStyle=0;fontColor=#2648b8;opacity=100;rotation=0;"><mxGeometry x="26" y="-1.42" width="192.766" height="88.08" as="geometry"></mxGeometry></mxCell><mxCell id="text-121" value="produce" vertex="1" parent="group-118" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Space Mono;fontSize=12.4;fontStyle=0;fontColor=#2648b8;opacity=100;rotation=0;"><mxGeometry x="48" y="0" width="53.125" height="18" as="geometry"></mxGeometry></mxCell><mxCell id="text-124" value="consume" vertex="1" parent="group-118" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Space Mono;fontSize=12.4;fontStyle=0;fontColor=#2648b8;opacity=100;rotation=0;"><mxGeometry x="176.08" y="0" width="53.125" height="18" as="geometry"></mxGeometry></mxCell><mxCell id="text-127" value="EVENT STREAMING · A FIELD GUIDE" vertex="1" parent="group-126" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalA