ontColor=#36322c;opacity=100;rotation=0;"><mxGeometry x="26" y="-0.97" width="78.775" height="20" as="geometry"></mxGeometry></mxCell><mxCell id="text-95" value="≈ 8 weeks" vertex="1" parent="group-94" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Fraunces;fontSize=16.7;fontStyle=2;fontColor=#36322c;opacity=100;rotation=0;"><mxGeometry x="26" y="-0.97" width="78.307" height="20" as="geometry"></mxGeometry></mxCell><mxCell id="text-97" value="Tip: the response letter is read&#xa;before the manuscript. Quote each&#xa;comment, answer it, and give the&#xa;page and line of the change." vertex="1" parent="group-96" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Fraunces;fontSize=16.7;fontStyle=2;fontColor=#36322c;opacity=100;rotation=0;"><mxGeometry x="24" y="-0.97" width="255.185" height="92.13" as="geometry"></mxGeometry></mxCell><mxCell id="text-101" value="SCHOLARLY PUBLISHING · ONE MANUSCRIPT" vertex="1" parent="group-100" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=JetBrains Mono;fontSize=12;fontStyle=1;fontColor=#c93c14;opacity=100;rotation=0;"><mxGeometry x="0" y="0" width="347.813" height="16" as="geometry"></mxGeometry></mxCell><mxCell id="text-102" value="Journal peer-review timeline" vertex="1" parent="group-100" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Fraunces;fontSize=54;fontStyle=1;fontColor=#171614;opacity=100;rotation=0;"><mxGeometry x="0" y="23.44" width="734.482" height="67" as="geometry"></mxGeometry></mxCell><mxCell id="text-103" value="Time runs down the page. Most of the five months are spent in the two long gaps — reviewer invitations and the author&apos;s&#xa;revision — not in anyone&apos;s actual reading." vertex="1" parent="group-100" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=18.4;fontStyle=0;fontColor=#6e685d;opacity=100;rotation=0;"><mxGeometry x="0" y="98.4" width="1050.048" height="48.68" as="geometry"></mxGeometry></mxCell><mxCell id="text-105" value="FIG. 71" vertex="1" parent="group-100" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=JetBrains Mono;fontSize=12;fontStyle=0;fontColor=#6e685d;opacity=100;rotation=0;"><mxGeometry x="1406.188" y="0" width="65.813" height="16" as="geometry"></mxGeometry></mxCell><mxCell id="text-107" value="MuseDraw · Editorial Ink" vertex="1" parent="group-106" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=JetBrains Mono;fontSize=10.5;fontStyle=0;fontColor=#6e685d;opacity=100;rotation=0;"><mxGeometry x="0" y="0" width="187.203" height="14" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
