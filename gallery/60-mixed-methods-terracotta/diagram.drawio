idth="11" height="22" as="geometry"></mxGeometry></mxCell><mxCell id="text-51" value="Report the joint display as a table: each row a predictor, with the matching theme and a quote that confirms, expands or&#xa;contradicts it." vertex="1" parent="group-49" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Fraunces;fontSize=16.2;fontStyle=2;fontColor=#3a2a20;opacity=100;rotation=0;"><mxGeometry x="25" y="-1.42" width="851.343" height="43.49" as="geometry"></mxGeometry></mxCell><mxCell id="text-54" value="Phase 1 — quantitative" vertex="1" parent="group-53" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=IBM Plex Mono;fontSize=12;fontStyle=1;fontColor=#c0583a;opacity=100;rotation=0;"><mxGeometry x="0" y="0" width="191.406" height="15" as="geometry"></mxGeometry></mxCell><mxCell id="text-55" value="Phase 2 — qualitative" vertex="1" parent="group-53" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=IBM Plex Mono;fontSize=12;fontStyle=1;fontColor=#6e7b3b;opacity=100;rotation=0;"><mxGeometry x="900" y="0" width="182.703" height="15" as="geometry"></mxGeometry></mxCell><mxCell id="text-57" value="RESEARCH DESIGN · EXPLANATORY SEQUENTIAL" vertex="1" parent="group-56" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=IBM Plex Mono;fontSize=12;fontStyle=1;fontColor=#c0583a;opacity=100;rotation=0;"><mxGeometry x="0" y="0" width="368" height="15" as="geometry"></mxGeometry></mxCell><mxCell id="text-58" value="Explanatory sequential mixed-methods design" vertex="1" parent="group-56" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Fraunces;fontSize=52;fontStyle=1;fontColor=#3a2a20;opacity=100;rotation=0;"><mxGeometry x="0" y="23.72" width="1123.794" height="64" as="geometry"></mxGeometry></mxCell><mxCell id="text-59" value="Capital letters mark the dominant strand. The connecting step is where most designs go wrong: the qualitative sample must be&#xa;chosen from the quantitative results, not by convenience." vertex="1" parent="group-56" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=18.4;fontStyle=0;fontColor=#7d6a5b;opacity=100;rotation=0;"><mxGeometry x="0" y="96.4" width="1099.932" height="48.68" as="geometry"></mxGeometry></mxCell><mxCell id="text-61" value="MuseDraw · Terracotta" vertex="1" parent="group-60" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=IBM Plex Mono;fontSize=10.5;fontStyle=0;fontColor=#7d6a5b;opacity=100;rotation=0;"><mxGeometry x="0" y="0" width="163.813" height="14" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
