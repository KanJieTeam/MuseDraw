"★" vertex="1" parent="group-41" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=LXGW WenKai;fontSize=19.03;fontStyle=1;fontColor=#f6dd72;opacity=100;rotation=0;"><mxGeometry x="-1" y="-4.43" width="21" height="25" as="geometry"></mxGeometry></mxCell><mxCell id="text-43" value="评价重点：谁改变了自己的猜想？谁能说出理由？观察记录只记这两件事。" vertex="1" parent="group-41" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=LXGW WenKai;fontSize=17.3;fontStyle=0;fontColor=#f3f1e7;opacity=100;rotation=0;"><mxGeometry x="26" y="-2.43" width="570.578" height="23" as="geometry"></mxGeometry></mxCell><mxCell id="text-46" value="端出一盆水和一筐&#xa;小物件，问：“谁会&#xa;沉下去？”" vertex="1" parent="group-45" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=LXGW WenKai;fontSize=17;fontStyle=0;fontColor=#f3f1e7;opacity=100;rotation=0;"><mxGeometry x="162" y="30" width="141.953" height="72.3" as="geometry"></mxGeometry></mxCell><mxCell id="text-47" value="自由说出想法，有&#xa;的孩子已经开始争" vertex="1" parent="group-45" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=LXGW WenKai;fontSize=17;fontStyle=0;fontColor=#f3f1e7;opacity=100;rotation=0;"><mxGeometry x="162" y="170" width="136" height="47.65" as="geometry"></mxGeometry></mxCell><mxCell id="text-48" value="发记录单，提醒“先&#xa;想好再贴”" vertex="1" parent="group-45" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=LXGW WenKai;fontSize=17;fontStyle=0;fontColor=#f3f1e7;opacity=100;rotation=0;"><mxGeometry x="343.25" y="30" width="141.953" height="47.65" as="geometry"></mxGeometry></mxCell><mxCell id="text-49" value="给每件物品贴红点&#xa;（沉）或蓝点（浮）" vertex="1" parent="group-45" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=LXGW WenKai;fontSize=17;fontStyle=0;fontColor=#f3f1e7;opacity=100;rotation=0;"><mxGeometry x="343.25" y="170" width="153" height="47.65" as="geometry"></mxGeometry></mxCell><mxCell id="text-50" value="巡回观察，只提问不讲解：“它为什么浮起来了？”" vertex="1" parent="group-45" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=LXGW WenKai;fontSize=17;fontStyle=0;fontColor=#f3f1e7;opacity=100;rotation=0;"><mxGeometry x="524.5" y="30" width="368.95" height="23" as="geometry"></mxGeometry></mxCell><mxCell id="text-51" value="四人一组逐个放进水里，对照自己贴的点" vertex="1" parent="group-45" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=LXGW WenKai;fontSize=17;fontStyle=0;fontColor=#f3f1e7;opacity=100;rotation=0;"><mxGeometry x="524.5" y="170" width="306" height="23" as="geometry"></mxGeometry></mxCell><mxCell id="text-52" value="先请猜错的孩子说" vertex="1" parent="group-45" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=LXGW WenKai;fontSize=17;fontStyle=0;fontColor=#f3f1e7;opacity=100;rotation=0;"><mxGeometry x="1068.25" y="30" width="136" height="23" as="geometry"></mxGeometry></mxCell><mxCell id="text-53" value="说出“哪个和我想的不一样”，再说“为什么”" vertex="1" parent="group-45" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=LXGW WenKai;fontSize=17;fontStyle=0;fontColor=#f3f1e7;opacity=100;rotation=0;"><mxGeometry x="1068.25" y="170" width="312.85" height="23" as="geometry"></mxGeometry></mxCell><mxCell id="text-54" value="布置亲子任务" vertex="1" parent="group-45" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=lef