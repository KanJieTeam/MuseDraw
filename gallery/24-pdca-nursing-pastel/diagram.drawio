lor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=14;fontStyle=0;fontColor=#37352f;opacity=100;rotation=0;"><mxGeometry x="1205.609" y="163" width="308.047" height="41" as="geometry"></mxGeometry></mxCell><mxCell id="text-89" value="C" vertex="1" parent="group-58" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=34;fontStyle=1;fontColor=#d9730d;opacity=100;rotation=0;"><mxGeometry x="1155.609" y="260" width="22.313" height="49" as="geometry"></mxGeometry></mxCell><mxCell id="text-90" value="检查" vertex="1" parent="group-58" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=16;fontStyle=1;fontColor=#37352f;opacity=100;rotation=0;"><mxGeometry x="1205.609" y="264" width="32" height="24" as="geometry"></mxGeometry></mxCell><mxCell id="text-91" value="每周统计跌倒与未遂事件。9 月降至 0.9‰，夜间&#xa;跌倒占比从 74% 降到 46%。" vertex="1" parent="group-58" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=14;fontStyle=0;fontColor=#37352f;opacity=100;rotation=0;"><mxGeometry x="1205.609" y="293" width="299.484" height="41" as="geometry"></mxGeometry></mxCell><mxCell id="text-92" value="A" vertex="1" parent="group-58" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=34;fontStyle=1;fontColor=#d9730d;opacity=100;rotation=0;"><mxGeometry x="1154.609" y="390" width="24" height="49" as="geometry"></mxGeometry></mxCell><mxCell id="text-93" value="处置" vertex="1" parent="group-58" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=16;fontStyle=1;fontColor=#37352f;opacity=100;rotation=0;"><mxGeometry x="1205.609" y="394" width="32" height="24" as="geometry"></mxGeometry></mxCell><mxCell id="text-94" value="巡视制度写入科室标准；下一轮聚焦术后首次下&#xa;床。" vertex="1" parent="group-58" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=14;fontStyle=0;fontColor=#37352f;opacity=100;rotation=0;"><mxGeometry x="1205.609" y="423" width="294" height="41" as="geometry"></mxGeometry></mxCell><mxCell id="text-96" value="护理质量改进 · 品管圈" vertex="1" parent="group-95" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=14;fontStyle=0;fontColor=#787774;opacity=100;rotation=0;"><mxGeometry x="0" y="0" width="152.281" height="20" as="geometry"></mxGeometry></mxCell><mxCell id="text-97" value="神经内科住院患者跌倒率改善" vertex="1" parent="group-95" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=42;fontStyle=1;fontColor=#37352f;opacity=100;rotation=0;"><mxGeometry x="0" y="21.12" width="546" height="61" as="geometry"></mxGeometry></mxCell><mxCell id="text-98" value="2026 年 1–9 月，每千住院日跌倒次数（‰），按 PDCA 阶段着色。目标为基线 1.8‰ 减半。数据为示例。" vertex="1" parent="group-95" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=17.3;fontStyle=0;fontColor=#787774;opacity=100;rotation=0;"><mxGeometry x="0" y="87.3" width="793.422" height="25" as="geometry"></mxGeometry></mxCell><mxCell id="text-100" value="MuseDraw · 柔和笔记" vertex="1" parent="group-99" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=12;fontStyle=0;fontColor=#