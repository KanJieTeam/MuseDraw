="Why two planes?" vertex="1" parent="group-122" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=14;fontStyle=1;fontColor=#101828;opacity=100;rotation=0;"><mxGeometry x="12" y="12" width="117.409" height="17" as="geometry"></mxGeometry></mxCell><mxCell id="text-125" value="Pooled tenants are cheap to serve; silo tenants buy isolation and their own&#xa;keys. The control plane stays single, so onboarding, billing and identity&#xa;never fork." vertex="1" parent="group-122" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=14;fontStyle=0;fontColor=#667085;opacity=100;rotation=0;"><mxGeometry x="12" y="31.6" width="491.266" height="59" as="geometry"></mxGeometry></mxCell><mxCell id="text-128" value="pooled tier" vertex="1" parent="group-126" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=13;fontStyle=0;fontColor=#667085;opacity=100;rotation=0;"><mxGeometry x="32" y="0" width="65.874" height="16" as="geometry"></mxGeometry></mxCell><mxCell id="text-130" value="silo tier" vertex="1" parent="group-126" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=13;fontStyle=0;fontColor=#667085;opacity=100;rotation=0;"><mxGeometry x="157.91" y="0" width="44.59" height="16" as="geometry"></mxGeometry></mxCell><mxCell id="text-133" value="check" vertex="1" parent="group-126" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=13;fontStyle=0;fontColor=#667085;opacity=100;rotation=0;"><mxGeometry x="282.79" y="0" width="38.12" height="16" as="geometry"></mxGeometry></mxCell><mxCell id="text-136" value="Multi-tenant SaaS on AWS" vertex="1" parent="group-135" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=13;fontStyle=1;fontColor=#4f46e5;opacity=100;rotation=0;"><mxGeometry x="1" y="0" width="170.628" height="16" as="geometry"></mxGeometry></mxCell><mxCell id="text-137" value="Multi-tenant SaaS: pooled and silo tiers" vertex="1" parent="group-135" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=44;fontStyle=1;fontColor=#101828;opacity=100;rotation=0;"><mxGeometry x="1" y="25.84" width="796.507" height="54" as="geometry"></mxGeometry></mxCell><mxCell id="text-138" value="One codebase and one pipeline serve every tenant. The tier in the token decides where a request runs: shared infrastructure&#xa;for Starter and Pro, a dedicated account for Enterprise." vertex="1" parent="group-135" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=18.4;fontStyle=0;fontColor=#667085;opacity=100;rotation=0;"><mxGeometry x="0" y="89.4" width="1083.925" height="48.68" as="geometry"></mxGeometry></mxCell><mxCell id="text-140" value="MuseDraw · Product Clean" vertex="1" parent="group-139" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=11;fontStyle=0;fontColor=#98a2b3;opacity=100;rotation=0;"><mxGeometry x="0" y="0" width="146.172" height="14" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
