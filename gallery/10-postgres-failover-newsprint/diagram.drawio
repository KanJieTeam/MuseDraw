Color=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=IBM Plex Mono;fontSize=10.8;fontStyle=1;fontColor=#c9c5bb;opacity=100;rotation=0;"><mxGeometry x="14" y="22.61" width="71.828" height="14" as="geometry"></mxGeometry></mxCell><mxCell id="text-47" value="etcd × 3" vertex="1" parent="group-44" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=17.3;fontStyle=1;fontColor=#faf8f3;opacity=100;rotation=0;"><mxGeometry x="14" y="37.74" width="68.625" height="21" as="geometry"></mxGeometry></mxCell><mxCell id="text-48" value="leader key, TTL 30 s" vertex="1" parent="group-44" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=IBM Plex Mono;fontSize=12.4;fontStyle=0;fontColor=#c9c5bb;opacity=100;rotation=0;"><mxGeometry x="14" y="60.02" width="148.813" height="16" as="geometry"></mxGeometry></mxCell><mxCell id="text-50" value="2" vertex="1" parent="group-44" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Instrument Serif;fontSize=17;fontStyle=0;fontColor=#f2efe7;opacity=100;rotation=0;"><mxGeometry x="-3.437" y="-11.05" width="7" height="22" as="geometry"></mxGeometry></mxCell><mxCell id="text-52" value="writes" vertex="1" parent="group-51" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Instrument Serif;fontSize=18.4;fontStyle=2;fontColor=#121212;opacity=100;rotation=0;"><mxGeometry x="0" y="0" width="40.574" height="24" as="geometry"></mxGeometry></mxCell><mxCell id="text-55" value="reads" vertex="1" parent="group-53" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Instrument Serif;fontSize=18.4;fontStyle=2;fontColor=#121212;opacity=100;rotation=0;"><mxGeometry x="3" y="2.48" width="37.286" height="24" as="geometry"></mxGeometry></mxCell><mxCell id="text-58" value="sync WAL" vertex="1" parent="group-56" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Instrument Serif;fontSize=18.4;fontStyle=2;fontColor=#121212;opacity=100;rotation=0;"><mxGeometry x="3" y="2.48" width="60.594" height="24" as="geometry"></mxGeometry></mxCell><mxCell id="text-60" value="async WAL" vertex="1" parent="group-59" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Instrument Serif;fontSize=18.4;fontStyle=2;fontColor=#121212;opacity=100;rotation=0;"><mxGeometry x="0" y="0" width="69.315" height="24" as="geometry"></mxGeometry></mxCell><mxCell id="text-62" value="archive_command" vertex="1" parent="group-61" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Instrument Serif;fontSize=18.4;fontStyle=2;fontColor=#121212;opacity=100;rotation=0;"><mxGeometry x="0" y="0" width="126.306" height="24" as="geometry"></mxGeometry></mxCell><mxCell id="text-65" value="1" vertex="1" parent="group-64" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Instrument Serif;fontSize=16.06;fontStyle=1;fontColor=#121212;opacity=100;rotation=0;"><mxGeometry x="-2" y="-2.86" width="8" height="21" as="geometry"></mxGeometry></mxCell><mxCell id="text-66" value="The primary stops&#xa;renewing its leader key —&#xa;crash, network split, or&#xa;a hung disk." vertex="1" parent="group-64" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=14.6;fontStyle=0;fontColor=#121212;opacity=100;rotation=0;"><mxGeometry x="26" y="-0.86" width="178.459" height="81.51" as="geometry"></mxGeometry></mxCell><mxCell id="text-68" value="2" vertex="1" parent="group-67" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Instrument Serif;fontSize=16.06;fontStyle=1;fontColor=#121212;opacity=100;rotation=0;"><mxGeometry x="-1" y="-2.86" width="9" height="21" as="geometry"></mxGeometry></mxCell><mxCell id="text-69" value="After 30 seconds the key&#xa;expires. Standbys race&#xa;to take it." vertex="1" parent="group-67" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=14.6;fontStyle=0;fontColor=#121212;opacity=100;rotation=0;"><mxGeometry x="25" y="-0.86" width="174.692" height="60.34" as="geometry"></mxGeometry></mxCell><mxCell id="text-71" value="3" vertex="1" parent="group-70" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Instrument Serif;fontSize=16.06;fontStyle=1;fontColor=#121212;opacity=100;rotation=0;"><mxGeometry x="-1" y="-2.86" width="8" height="21" as="geometry"></mxGeometry></mxCell><mxCell id="text-72" value="The sync standby wins: it&#xa;already holds every&#xa;committed transaction." vertex="1" parent="group-70" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=14.6;fontStyle=0;fontColor=#121212;opacity=100;rotation=0;"><mxGeometry x="26" y="-0.86" width="175.609" height="60.34" as="geometry"></mxGeometry></mxCell><mxCell id="text-74" value="4" vertex="1" parent="group-73" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Instrument Serif;fontSize=16.06;fontStyle=1;fontColor=#121212;opacity=100;rotation=0;"><mxGeometry x="-2" y="-2.86" width="10" height="21" as="geometry"></mxGeometry></mxCell><mxCell id="text-75" value="HAProxy health checks&#xa;find the new leader.&#xa;Writes resume, usually&#xa;within a minute." vertex="1" parent="group-73" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=14.6;fontStyle=0;fontColor=#121212;opacity=100;rotation=0;"><mxGeometry x="25" y="-0.86" width="161.801" height="81.51" as="geometry"></mxGeometry></mxCell><mxCell id="text-79" value="client traffic" vertex="1" parent="group-76" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=IBM Plex Mono;fontSize=11.9;fontStyle=0;fontColor=#121212;opacity=100;rotation=0;"><mxGeometry x="48" y="0" width="99.969" height="15" as="geometry"></mxGeometry></mxCell><mxCell id="text-82" value="WAL, synchronous" vertex="1" parent="group-76" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=IBM Plex Mono;fontSize=11.9;fontStyle=0;fontColor=#121212;opacity=100;rotation=0;"><mxGeometry x="223.96" y="0" width="114.25" height="15" as="geometry"></mxGeometry></mxCell><mxCell id="text-85" value="WAL, async" vertex="1" parent="group-76" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=IBM Plex Mono;fontSize=11.9;fontStyle=0;fontColor=#121212;opacity=100;rotation=0;"><mxGeometry x="414.2" y="0" width="71.406" height="15" as="geometry"></mxGeometry></mxCell><mxCell id="text-88" value="control plane" vertex="1" parent="group-76" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=IBM Plex Mono;fontSize=11.9;fontStyle=0;fontColor=#121212;opacity=100;rotation=0;"><mxGeometry x="561.6" y="0" width="92.828" height="15" as="geometry"></mxGeometry></mxCell><mxCell id="text-90" value="Failover, in four beats" vertex="1" parent="group-89" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Instrument Serif;fontSize=22;fontStyle=0;fontColor=#121212;opacity=100;rotation=0;"><mxGeometry x="0" y="0" width="159.812" height="29" as="geometry"></mxGeometry></mxCell><mxCell id="text-92" value="STREAMING REPLICATION &amp; AUTOMATIC FAILOVER" vertex="1" parent="group-91" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=IBM Plex Mono;fontSize=12;fontStyle=1;fontColor=#121212;opacity=100;rotation=0;"><mxGeometry x="0" y="0" width="386.406" height="15" as="geometry"></mxGeometry></mxCell><mxCell id="text-93" value="PostgreSQL streaming replication and failover" vertex="1" parent="group-91" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Instrument Serif;fontSize=64;fontStyle=0;fontColor=#121212;opacity=100;rotation=0;"><mxGeometry x="0" y="22.04" width="970.264" height="83" as="geometry"></mxGeometry></mxCell><mxCell id="text-94" value="Every write lands in the write-ahead log first. Standbys replay that log; a consensus store decides who leads when the primary goes&#xa;quiet." vertex="1" parent="group-91" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=17.3;fontStyle=0;fontColor=#555249;opacity=100;rotation=0;"><mxGeometry x="0" y="108.3" width="1078.672" height="46.09" as="geometry"></mxGeometry></mxCell><mxCell id="text-96" value="FIG. 3" vertex="1" parent="group-91" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;v