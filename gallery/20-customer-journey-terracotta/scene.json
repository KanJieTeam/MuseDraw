  {
   "x": 346.0,
   "y": 493,
   "text": "“Looks like it fixes our reporting mess.”",
   "font": "display",
   "size": 13.5,
   "italic": true,
   "color": "ink",
   "anchor": "middle",
   "w": 202
  },
  {
   "x": 578.0,
   "y": 512,
   "text": "“Which plan do we actually need?”",
   "font": "display",
   "size": 13.5,
   "italic": true,
   "color": "ink",
   "anchor": "middle",
   "w": 202
  },
  {
   "x": 810.0,
   "y": 679,
   "text": "“Why does security need four weeks?”",
   "font": "display",
   "size": 13.5,
   "italic": true,
   "color": "ink",
   "anchor": "middle",
   "w": 202
  },
  {
   "x": 1042.0,
   "y": 651,
   "text": "“Importing was harder than promised.”",
   "font": "display",
   "size": 13.5,
   "italic": true,
   "color": "ink",
   "anchor": "middle",
   "w": 202
  },
  {
   "x": 1274.0,
   "y": 475,
   "text": "“I got my Fridays back.”",
   "font": "display",
   "size": 13.5,
   "italic": true,
   "color": "ink",
   "anchor": "middle",
   "w": 202
  },
  {
   "x": 1506.0,
   "y": 526,
   "text": "“Fair price — if usage stays this high.”",
   "font": "display",
   "size": 13.5,
