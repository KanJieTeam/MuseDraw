e;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=13;fontStyle=0;fontColor=#5b6b80;opacity=100;rotation=0;"><mxGeometry x="7" y="0.35" width="26" height="19" as="geometry"></mxGeometry></mxCell><mxCell id="text-75" value="收货单" vertex="1" parent="group-73" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=13;fontStyle=0;fontColor=#5b6b80;opacity=100;rotation=0;"><mxGeometry x="7" y="0.35" width="39" height="19" as="geometry"></mxGeometry></mxCell><mxCell id="text-78" value="发票" vertex="1" parent="group-76" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=13;fontStyle=0;fontColor=#5b6b80;opacity=100;rotation=0;"><mxGeometry x="7" y="0.35" width="26" height="19" as="geometry"></mxGeometry></mxCell><mxCell id="text-82" value="改进建议" vertex="1" parent="group-80" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=14;fontStyle=1;fontColor=#0b2a4a;opacity=100;rotation=0;"><mxGeometry x="12" y="10" width="57" height="20" as="geometry"></mxGeometry></mxCell><mxCell id="text-83" value="询价比价平均耗时 6.5 天，占全流程 40%。建议对 2 万元以下常用品建立年度框架协议，直接下单。" vertex="1" parent="group-80" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=14;fontStyle=0;fontColor=#5b6b80;opacity=100;rotation=0;"><mxGeometry x="12" y="29.6" width="617.328" height="20" as="geometry"></mxGeometry></mxCell><mxCell id="text-87" value="跨部门泳道图" vertex="1" parent="group-86" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=14;fontStyle=1;fontColor=#1f5fa8;opacity=100;rotation=0;"><mxGeometry x="0" y="0" width="102" height="20" as="geometry"></mxGeometry></mxCell><mxCell id="text-88" value="采购审批跨部门泳道图" vertex="1" parent="group-86" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=40;fontStyle=1;fontColor=#0e1b2e;opacity=100;rotation=0;"><mxGeometry x="0" y="22.4" width="400" height="58" as="geometry"></mxGeometry></mxCell><mxCell id="text-89" value="五个角色、两道金额闸门、一次三单匹配。谁在什么时候做什么，一行看清；琥珀色是最容易卡住的节点。" vertex="1" parent="group-86" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=16.7;fontStyle=0;fontColor=#5b6b80;opacity=100;rotation=0;"><mxGeometry x="0" y="85.7" width="784.906" height="24" as="geometry"></mxGeometry></mxCell><mxCell id="text-92" value="MuseDraw · 商务墨蓝" vertex="1" parent="group-91" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=11;fontStyle=0;fontColor=#9aa9bc;opacity=100;rotation=0;"><mxGeometry x="0" y="0" width="143.313" height="16" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
