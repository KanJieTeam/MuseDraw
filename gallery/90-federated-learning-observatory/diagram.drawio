21" as="geometry"></mxGeometry></mxCell><mxCell id="text-53" value="server sees only the sum; ε = 3" vertex="1" parent="group-47" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=JetBrains Mono;fontSize=12.4;fontStyle=0;fontColor=#d4b48a;opacity=100;rotation=0;"><mxGeometry x="46" y="42.12" width="230.641" height="17" as="geometry"></mxGeometry></mxCell><mxCell id="text-56" value="// one round: send global weights → 5 local epochs at each&#xa;site → upload weight deltas → average. 120 rounds to&#xa;converge." vertex="1" parent="group-55" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=JetBrains Mono;fontSize=13;fontStyle=0;fontColor=#7e8da0;opacity=100;rotation=0;"><mxGeometry x="0" y="-1.3" width="457.609" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="text-58" value="// pooled AUC 0.91 vs 0.86 for the best single-site model;&#xa;no patient image ever crossed a hospital firewall" vertex="1" parent="group-57" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=JetBrains Mono;fontSize=13;fontStyle=0;fontColor=#7e8da0;opacity=100;rotation=0;"><mxGeometry x="0" y="-1.3" width="452.406" height="36.5" as="geometry"></mxGeometry></mxCell><mxCell id="text-62" value="weight deltas" vertex="1" parent="group-59" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=JetBrains Mono;fontSize=12.4;fontStyle=0;fontColor=#7e8da0;opacity=100;rotation=0;"><mxGeometry x="48" y="0" width="96.734" height="17" as="geometry"></mxGeometry></mxCell><mxCell id="text-65" value="global model" vertex="1" parent="group-59" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=JetBrains Mono;fontSize=12.4;fontStyle=0;fontColor=#7e8da0;opacity=100;rotation=0;"><mxGeometry x="220.72" y="0" width="89.84" height="17" as="geometry"></mxGeometry></mxCell><mxCell id="text-68" value="MEDICAL IMAGING · PRIVACY-PRESERVING TRAINING" vertex="1" parent="group-67" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=JetBrains Mono;fontSize=12;fontStyle=1;fontColor=#4fd1c5;opacity=100;rotation=0;"><mxGeometry x="0" y="0" width="414" height="16" as="geometry"></mxGeometry></mxCell><mxCell id="text-69" value="Federated learning across five hospitals" vertex="1" parent="group-67" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=46;fontStyle=1;fontColor=#dce4ee;opacity=100;rotation=0;"><mxGeometry x="0" y="24.56" width="850.493" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="text-70" value="Teal arrows carry weight updates in, violet arrows carry the new global model out. Raw images stay inside each hospital. Figures are&#xa;illustrative." vertex="1" parent="group-67" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=17.8;fontStyle=0;fontColor=#7e8da0;opacity=100;rotation=0;"><mxGeometry x="0" y="90.8" width="1112.969" height="46.81" as="geometry"></mxGeometry></mxCell><mxCell id="text-71" value="FIG / 90" vertex="1" parent="group-67" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=JetBrains Mono;fontSize=12;fontStyle=0;fontColor=#7e8da0;opacity=100;rotation=0;"><mxGeometry x="1458.391" y="0" width="73.609" height="16" as="geometry"></mxGeometry></mxCell><mxCell id="text-73" value="MuseDraw · Observatory" vertex="1" parent="group-72" style="text;html=0;fillColor=none;s