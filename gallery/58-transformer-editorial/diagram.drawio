;rotation=0;"><mxGeometry x="63.094" y="4.42" width="113.813" height="19" as="geometry"></mxGeometry></mxCell><mxCell id="text-41" value="queries from decoder,&#xa;keys/values from encoder" vertex="1" parent="group-38" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=JetBrains Mono;fontSize=12.4;fontStyle=0;fontColor=#c9c0af;opacity=100;rotation=0;"><mxGeometry x="30.719" y="25.28" width="178.563" height="33.37" as="geometry"></mxGeometry></mxCell><mxCell id="text-44" value="Add &amp; norm" vertex="1" parent="group-42" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=15;fontStyle=1;fontColor=#171614;opacity=100;rotation=0;"><mxGeometry x="77.586" y="9.8" width="84.828" height="19" as="geometry"></mxGeometry></mxCell><mxCell id="text-47" value="Feed-forward" vertex="1" parent="group-45" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=15;fontStyle=1;fontColor=#171614;opacity=100;rotation=0;"><mxGeometry x="70.367" y="15.8" width="99.266" height="19" as="geometry"></mxGeometry></mxCell><mxCell id="text-50" value="Add &amp; norm" vertex="1" parent="group-48" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=15;fontStyle=1;fontColor=#171614;opacity=100;rotation=0;"><mxGeometry x="77.586" y="9.8" width="84.828" height="19" as="geometry"></mxGeometry></mxCell><mxCell id="text-53" value="Linear" vertex="1" parent="group-51" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=15;fontStyle=1;fontColor=#171614;opacity=100;rotation=0;"><mxGeometry x="97.414" y="9.8" width="45.214" height="19" as="geometry"></mxGeometry></mxCell><mxCell id="text-56" value="Softmax → next-token probabilities" vertex="1" parent="group-54" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=15;fontStyle=1;fontColor=#f7f1e6;opacity=100;rotation=0;"><mxGeometry x="22.398" y="13.8" width="255.203" height="19" as="geometry"></mxGeometry></mxCell><mxCell id="text-59" value="memory" vertex="1" parent="group-57" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Fraunces;fontSize=15.1;fontStyle=2;fontColor=#3a362f;opacity=100;rotation=0;"><mxGeometry x="4" y="2.35" width="56.807" height="19" as="geometry"></mxGeometry></mxCell><mxCell id="text-62" value="1" vertex="1" parent="group-61" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Fraunces;fontSize=18.37;fontStyle=1;fontColor=#c93c14;opacity=100;rotation=0;"><mxGeometry x="0" y="-2.97" width="9" height="23" as="geometry"></mxGeometry></mxCell><mxCell id="text-63" value="Attention(Q, K, V) = softmax(QKᵀ / √dₖ) V. Each token&#xa;looks at every other token and takes a weighted average." vertex="1" parent="group-61" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Fraunces;fontSize=16.7;fontStyle=2;fontColor=#36322c;opacity=100;rotation=0;"><mxGeometry x="25" y="-0.97" width="413.665" height="44.71" as="geometry"></mxGeometry></mxCell><mxCell id="text-65" value="2" vertex="1" parent="group-64" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Fraunces;fontSize=18.37;fontStyle=1;fontColor=#c93c14;opacity=100;rotation=0;"><mxGeometry x="0" y="-2.97" width="12" height="23" as="geometry"></mxGeometry></mxCell><mxCell id="text-66" value="Multi-head: 8 heads of 64 dimensions run in parallel, each&#xa;free to learn a different relation — syntax, coreference,&#xa;position." vertex="1" parent="group-64" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Fraunces;fontSize=16.7;fontStyle=2;fontColor=#36322c;opacity=100;rotation=0;"><mxGeometry x="24" y="-0.97" width="430.159" height="67.42" as="geometry"></mxGeometry></mxCell><mxCell id="text-68" value="3" vertex="1" parent="group-67" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Fraunces;fontSize=18.37;fontStyle=1;fontColor=#c93c14;opacity=100;rotation=0;"><mxGeometry x="0" y="-2.97" width="11" height="23" as="geometry"></mxGeometry></mxCell><mxCell id="text-69" value="Masking stops the decoder from peeking at future&#xa;tokens, so training and generation see the same thing." vertex="1" parent="group-67" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Fraunces;fontSize=16.7;fontStyle=2;fontColor=#36322c;opacity=100;rotation=0;"><mxGeometry x="25" y="-0.97" width="395.345" height="44.71" as="geometry"></mxGeometry></mxCell><mxCell id="text-71" value="4" vertex="1" parent="group-70" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Fraunces;fontSize=18.37;fontStyle=1;fontColor=#c93c14;opacity=100;rotation=0;"><mxGeometry x="0" y="-2.97" width="12.172" height="23" as="geometry"></mxGeometry></mxCell><mxCell id="text-72" value="Dotted lines are residual connections: every sub-layer&#xa;only learns a correction to its input." vertex="1" parent="group-70" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Fraunces;fontSize=16.7;fontStyle=2;fontColor=#36322c;opacity=100;rotation=0;"><mxGeometry x="25" y="-0.97" width="398.575" height="44.71" as="geometry"></mxGeometry></mxCell><mxCell id="text-75" value="source tokens" vertex="1" parent="group-74" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Fraunces;fontSize=14;fontStyle=2;fontColor=#6e685d;opacity=100;rotation=0;"><mxGeometry x="0" y="0" width="86.442" height="18" as="geometry"></mxGeometry></mxCell><mxCell id="text-76" value="target tokens, shifted right" vertex="1" parent="group-74" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Fraunces;fontSize=14;fontStyle=2;fontColor=#6e685d;opacity=100;rotation=0;"><mxGeometry x="400.922" y="0" width="165.453" height="18" as="geometry"></mxGeometry></mxCell><mxCell id="text-78" value="MACHINE LEARNING · VASWANI ET AL., 2017" vertex="1" parent="group-77" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=JetBrains Mono;fontSize=12;fontStyle=1;fontColor=#c93c14;opacity=100;rotation=0;"><mxGeometry x="1" y="0" width="366.609" height="16" as="geometry"></mxGeometry></mxCell><mxCell id="text-79" value="Transformer architecture" vertex="1" parent="group-77" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Fraunces;fontSize=54;fontStyle=1;fontColor=#171614;opacity=100;rotation=0;"><mxGeometry x="1" y="23.44" width="655.494" height="67" as="geometry"></mxGeometry></mxCell><mxCell id="text-80" value="Two stacks of identical blocks. The encoder turns a sentence into context-rich vectors; the decoder writes the output one&#xa;token at a time while attending to them." vertex="1" parent="group-77" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;fontSize=18.4;fontStyle=0;fontColor=#6e685d;opacity=100;rotation=0;"><mxGeometry x="0" y="98.4" width="1059.326" height="48.68" as="geometry"></mxGeometry></mxCell><mxCell id="text-82" value="FIG. 58" vertex="1" parent="group-77" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=JetBrains Mono;fontSize=12;fontStyle=0;fontColor=#6e685d;opacity=100;rotation=0;"><mxGeometry x="1407.188" y="0" width="65.813" height="16" as="geometry"></mxGeometry></mxCell><mxCell id="text-84" value="MuseDraw · Editorial Ink" vertex="1" parent="group-83" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=JetBrains Mono;fontSize=10.5;fontStyle=0;fontColor=#6e685d;opacity=100;rotation=0;"><mxGeometry x="0" y="0" width="187.203" height="14" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
