 "notes": [
  {
   "num": "1",
   "text": "Attention(Q, K, V) = softmax(QKᵀ / √dₖ) V. Each token looks at every other token and takes a weighted average.",
   "x": 1040,
   "y": 360,
   "w": 480
  },
  {
   "num": "2",
   "text": "Multi-head: 8 heads of 64 dimensions run in parallel, each free to learn a different relation — syntax, coreference, position.",
   "x": 1040,
   "y": 510,
   "w": 480
  },
  {
   "num": "3",
   "text": "Masking stops the decoder from peeking at future tokens, so training and generation see the same thing.",
   "x": 1040,
   "y": 660,
   "w": 480
  },
  {
   "num": "4",
   "text": "Dotted lines are residual connections: every sub-layer only learns a correction to its input.",
   "x": 1040,
   "y": 800,
   "w": 480
  }
 ],
