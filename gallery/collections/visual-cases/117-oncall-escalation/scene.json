=\"#000000\" opacity=\"0.08\"/>\n<path d=\"M1507.6,480.0 C1510.3,496.4 1503.5,519.3 1488.8,532.3 C1474.0,545.3 1442.1,551.0 1418.9,558.0 C1395.8,565.0 1375.0,571.9 1350.0,574.2 C1325.0,576.4 1291.1,578.9 1269.1,571.5 C1247.2,564.1 1228.6,544.9 1218.4,529.6 C1208.3,514.4 1206.5,496.0 1208.1,480.0 C1209.6,464.0 1217.2,448.7 1227.7,433.9 C1238.2,419.0 1250.8,400.6 1271.2,390.8 C1291.6,381.0 1325.1,373.7 1350.0,375.3 C1374.9,376.8 1400.3,390.2 1420.7,400.0 C1441.1,409.8 1457.7,420.6 1472.2,433.9 C1486.7,447.2 1504.8,463.6 1507.6,480.0 Z\" fill=\"#5B3A29\"/>\n<text x=\"1350\" y=\"462\" font-family=\"'Noto Sans CJK SC', sans-serif\" font-size=\"32\" font-weight=\"800\" fill=\"#F7EFE4\" text-anchor=\"middle\">事故指挥</text>\n<text x=\"1350\" y=\"498\" font-family=\"'Noto Sans CJK SC', sans-serif\" font-size=\"17\" fill=\"#F7EFE4\" text-anchor=\"middle\"><tspan x=\"1350\" dy=\"0\">升级为事故</tspan><tspan x=\"1350\" dy=\"25.5\">通知业务负责人</tspan></text>\n<text x=\"1350\" y=\"356\" font-family=\"'Noto Sans CJK SC', sans-serif\" font-size=\"22\" font-weight=\"700\" fill=\"#4E342A\" text-anchor=\"middle\">30 分钟</text>\n</g>\n<g id=\"layer5\" inkscape:groupmode=\"layer\" inkscape:label=\"级别\">\n<rect x=\"80\" y=\"700\" width=\"450\" height=\"200\" rx=\"28\" fill=\"#D7BFA3\"/>\n<rect x=\"80\" y=\"700\" width=\"450\" height=\"200\" rx=\"28\" fill=\"none\" stroke=\"#C7AE8F\" stroke-width=\"1.5\"/>\n<text x=\"114\" y=\"776\" font-family=\"'Noto Sans CJK SC', sans-serif\" font-size=\"52\" font-weight=\"800\" fill=\"#B5613C\">P1</text>\n<text x=\"230\" y=\"764\" font-family=\"'Noto Sans CJK SC', sans-serif\" font-size=\"24\" font-weight=\"700\" fill=\"#4E342A\">核心功能不可用</text>\n<text x=\"230\" y=\"800\" font-family=\"'Noto Sans CJK SC', sans-serif\" font-size=\"18\" fill=\"#6B4C3B\"><tspan x=\"230\" dy=\"0\">5 分钟内确认，按上面的路径升级</tspan></text>\n<rect x=\"570\" y=\"700\" width=\"450\" height=\"200\" rx=\"28\" fill=\"#DFCDB6\"/>\n<rect x=\"570\" y=\"700\" width=\"450\" height=\"200\" rx=\"28\" fill=\"none\" stroke=\"#C7AE8F\" stroke-width=\"1.5\"/>\n<text x=\"604\" y=\"776\" font-family=\"'Noto Sans CJK SC', sans-serif\" font-size=\"52\" font-weight=\"800\" fill=\"#4E342A\">P2</text>\n<text x=\"720\" y=\"764\" font-family=\"'Noto Sans CJK SC', sans-serif\" font-size=\"24\" font-weight=\"700\" fill=\"#4E342A\">部分用户受影响</text>\n<text x=\"720\" y=\"800\" font-family=\"'Noto Sans CJK SC', sans-serif\" font-size=\"18\" fill=\"#6B4C3B\"><tspan x=\"720\" dy=\"0\">15 分钟内确认，只呼叫主值班</tspan></text>\n<rect x=\"1060\" y=\"700\" width=\"450\" height=\"200\" rx=\"28\" fill=\"#E6D8C5\"/>\n<rect x=\"1060\" y=\"700\" width=\"450\" height=\"200\" rx=\"28\" fill=\"none\" stroke=\"#C7AE8F\" stroke-width=\"1.5\"/>\n<text x=\"1094\" y=\"776\" font-family=\"'Noto Sans CJK SC', sans-serif\" font-size=\"52\" font-weight=\"800\" fill=\"#4E342A\">P3</text>\n<text x=\"1210\" y=\"764\" font-family=\"'Noto Sans CJK SC', sans-serif\" font-size=\"24\" font-weight=\"700\" fill=\"#4E342A\">没有用户受影响</text>\n<text x=\"1210\" y=\"800\" font-family=\"'Noto Sans CJK SC', sans-serif\" font-size=\"18\" fill=\"#6B4C3B\"><tspan x=\"1210\" dy=\"0\">下一个工作日处理，记成工单</tspan></text>\n<text x=\"80\" y=\"950\" font-family=\"'Noto Sans CJK SC', sans-serif\" font-size=\"18\" fill=\"#7A5A48\">时间都从告警触发时算起；任何一级确认后，升级就停止。</text>\n</g>\n</svg>"
