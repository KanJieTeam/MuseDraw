-serif\" font-size=\"14\" fill=\"#111111\" text-anchor=\"middle\">服务器 6</text>\n<line x1=\"200\" y1=\"445\" x2=\"330\" y2=\"626\" stroke=\"#666666\" stroke-width=\"1\"/>\n<rect x=\"330\" y=\"602\" width=\"130\" height=\"48\" fill=\"url(#hatch)\" stroke=\"#111111\" stroke-width=\"1.5\"/>\n<rect x=\"338\" y=\"614\" width=\"114\" height=\"24\" fill=\"#FFFFFF\"/>\n<text x=\"395\" y=\"632\" font-family=\"'Noto Sans CJK SC', sans-serif\" font-size=\"14\" fill=\"#111111\" text-anchor=\"middle\">服务器 7（慢）</text>\n<line x1=\"200\" y1=\"445\" x2=\"330\" y2=\"698\" stroke=\"#666666\" stroke-width=\"1\"/>\n<rect x=\"330\" y=\"674\" width=\"130\" height=\"48\" fill=\"url(#hatch)\" stroke=\"#111111\" stroke-width=\"1.5\"/>\n<rect x=\"338\" y=\"686\" width=\"114\" height=\"24\" fill=\"#FFFFFF\"/>\n<text x=\"395\" y=\"704\" font-family=\"'Noto Sans CJK SC', sans-serif\" font-size=\"14\" fill=\"#111111\" text-anchor=\"middle\">服务器 8（慢）</text>\n<text x=\"330\" y=\"770\" font-family=\"'Noto Sans CJK SC', sans-serif\" font-size=\"14\" fill=\"#666666\">慢服务器速度为其余的一半</text>\n<text x=\"330\" y=\"792\" font-family=\"'Noto Sans CJK SC', sans-serif\" font-size=\"14\" fill=\"#666666\">总处理能力 = 6 × 1 + 2 × 0.5 = 7</text>\n</g>\n<g id=\"layer4\" inkscape:groupmode=\"layer\" inkscape:label=\"b 延迟分布\">\n<text x=\"530\" y=\"130\" font-family=\"'Noto Sans CJK SC', sans-serif\" font-size=\"30\" font-weight=\"800\" fill=\"#111111\">b</text>\n<text x=\"560\" y=\"128\" font-family=\"'Noto Sans CJK SC', sans-serif\" font-size=\"18\" fill=\"#666666\">负载 ρ = 0.5 时的延迟累积分布</text>\n<line x1=\"584\" y1=\"700\" x2=\"590\" y2=\"700\" stroke=\"#111111\"/>\n<text x=\"578\" y=\"705\" font-family=\"'Noto Sans CJK SC', sans-serif\" font-size=\"14\" fill=\"#111111\" text-anchor=\"end\">0</text>\n<line x1=\"584\" y1=\"565\" x2=\"590\" y2=\"565\" stroke=\"#111111\"/>\n<text x=\"578\" y=\"570\" font-family=\"'Noto Sans CJK SC', sans-serif\" font-size=\"14\" fill=\"#111111\" text-anchor=\"end\">0.25</text>\n<line x1=\"590\"