审批流程" vertex="1" parent="group-83" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=42;fontStyle=1;fontColor=#37352f;opacity=100;rotation=0;"><mxGeometry x="0" y="21.12" width="336" height="61" as="geometry"></mxGeometry></mxCell><mxCell id="text-86" value="金额决定谁审批，票据决定能不能付款。大部分退回发生在财务审核这一步，且原因高度集中。数据为示例。" vertex="1" parent="group-83" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=17.3;fontStyle=0;fontColor=#787774;opacity=100;rotation=0;"><mxGeometry x="0" y="87.3" width="829.922" height="25" as="geometry"></mxGeometry></mxCell><mxCell id="text-88" value="MuseDraw · 柔和笔记" vertex="1" parent="group-87" style="text;html=0;fillColor=none;strokeColor=none;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans SC;fontSize=12;fontStyle=0;fontColor=#b4b4b0;opacity=100;rotation=0;"><mxGeometry x="0" y="0" width="138.625" height="17" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
